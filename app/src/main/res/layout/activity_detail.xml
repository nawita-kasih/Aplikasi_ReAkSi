<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PANDUAN DARURAT"
            android:fontFamily="sans-serif-black"
            android:textSize="24sp"
            android:textColor="#B71C1C"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/neo_brutal_container"
            android:orientation="vertical"
            android:padding="4dp"
            android:layout_marginBottom="20dp">

            <VideoView
                android:id="@+id/videoViewTutorial"
                android:layout_width="match_parent"
                android:layout_height="200dp" />

            <Button
                android:id="@+id/btnPlayVideo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PUTAR VIDEO TUTORIAL"
                android:backgroundTint="#000000"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-black"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LANGKAH PENANGANAN:"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="@drawable/neo_brutal_blue"
            android:padding="4dp">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerSteps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="*Geser ke samping untuk langkah berikutnya"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:fontFamily="sans-serif-condensed-italic"/>

    </LinearLayout>
</ScrollView>